# EmailJS — https://www.emailjs.com/
# Same service + public key for both templates.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Assessment results (sent TO the user)
# Template To email: {{email}}
# HTML: emailjs/assessment-email-template.html
VITE_EMAILJS_TEMPLATE_ID=your_assessment_template_id

# Contact form (sent TO your inbox)
# Template To email: hello@convolingua.com (fixed) or {{to_email}}
# Reply to: {{user_email}}
# HTML: emailjs/contact-form-template.html
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id

VITE_CONTACT_EMAIL=hello@convolingua.com
VITE_COMPANY_NAME=ConvoLingua

# Optional — overrides booking link in emails (default: src/config/site.js)
# VITE_BOOKING_LINK=https://convolingua20.vercel.app/contact
